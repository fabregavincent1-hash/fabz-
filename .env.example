# Twitch API (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube / Google API (https://console.cloud.google.com)
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=
# Path to OAuth2 client secrets JSON downloaded from Google Cloud Console
YOUTUBE_OAUTH_CREDENTIALS_FILE=client_secrets.json

# TikTok for Developers (https://developers.tiktok.com)
# Requires Content Posting API access approval
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (https://developers.facebook.com)
# Requires Facebook Business account + Instagram Professional account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Whisper model size: tiny, base, small, medium, large
# Larger = more accurate but slower. "base" is a good default.
OPENAI_WHISPER_MODEL=base
